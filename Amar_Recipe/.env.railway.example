# Railway Environment Variables Template
# Copy these to your Railway project: Dashboard > Variables

# ===========================================
# DATABASE CONFIGURATION (Railway MySQL)
# ===========================================
# These will be automatically provided by Railway when you add MySQL service
# Reference them exactly as shown below
DB_HOST=${{MYSQLHOST}}
DB_PORT=${{MYSQLPORT}}
DB_USER=${{MYSQLUSER}}
DB_PASS=${{MYSQLPASSWORD}}
DB_NAME=${{MYSQLDATABASE}}

# ===========================================
# APPLICATION URLs
# ===========================================
# RAILWAY_PUBLIC_DOMAIN is automatically provided by Railway
# Format: your-project-name-production.up.railway.app
BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/
API_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/src/api/

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Your Vercel frontend domain (update after Vercel deployment)
ALLOWED_ORIGIN=https://your-vercel-app.vercel.app

# ===========================================
# APACHE/PHP CONFIGURATION
# ===========================================
# Railway provides this automatically
PORT=${{PORT}}

# ===========================================
# NOTES
# ===========================================
# 1. Add MySQL service first in Railway dashboard
# 2. MySQL variables will auto-populate
# 3. Update ALLOWED_ORIGIN with your actual Vercel domain
# 4. Do NOT manually set PORT - Railway handles this
