# Environment Variables Configuration
# This file serves as a template for setting up environment variables
# IMPORTANT: Copy this file to the appropriate environment file and update values

# ==========================================
# LOCAL DEVELOPMENT
# ==========================================
# Copy to: .env.local
# Usage: For local XAMPP/WAMP development

# VITE_API_BASE_URL=http://localhost/Amar_Recipies_Live/Amar_Recipe/src/api/
# VITE_ADMIN_API_BASE_URL=http://localhost/Amar_Recipies_Live/Amar_Recipe/admin_api/

# ==========================================
# PRODUCTION (Supabase + Render/Vercel)
# ==========================================
# Usage: For Vercel/Render production deployment
# Set these in your hosting provider's environment variables dashboard

# Option 1: Using Connection String (Recommended for Render)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.iseehucuytvgtpdqupzp.supabase.co:5432/postgres

# Option 2: Individual Variables
DB_TYPE=pgsql
DB_HOST=db.iseehucuytvgtpdqupzp.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-password-here
DB_NAME=postgres

# Supabase Client (Optional if using Supabase JS SDK later)
VITE_SUPABASE_URL=https://iseehucuytvgtpdqupzp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_RQrGCRUYSEgMDlzvyG7E0g_Be-0uXS3

# ==========================================
# NOTES
# ==========================================
# - Never commit .env.local or .env.production with actual credentials
# - Set production variables in Vercel dashboard under Project Settings > Environment Variables
# - For local development, use .env.local (already in .gitignore)
# - Backend database credentials are configured in src/api/config.php
